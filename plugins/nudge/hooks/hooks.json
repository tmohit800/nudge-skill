{
  "description": "One artifact per session: tells each session the rule, asks before a second new artifact is published, and remembers what each session published. Also refreshes the Artifact Shelf in the background after every publish or delete.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/artifacts/scripts/guard.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/artifacts/scripts/shelf.js\" ensure",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Artifact|.*Claude_Docs__(batch|create)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/artifacts/scripts/guard.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Artifact|.*Claude_Docs__(batch|create)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/artifacts/scripts/guard.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/artifacts/scripts/shelf.js\" hook",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Artifact|.*Claude_Docs__(batch|create)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/artifacts/scripts/guard.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
